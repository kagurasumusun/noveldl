<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nyxian project format "AvisR2" (NXProjectFormat = NXAvixR2).
	     Keys mirror emexlab/Nyxian createProjectAtURL output
	     (Nyxian/LindChain/Project/NXProject.m + NXCodeTemplate.m). -->
	<key>NXProjectFormat</key>
	<string>NXAvixR2</string>
	<key>NXProjectScheme</key>
	<string>Application</string>
	<key>NXExecutable</key>
	<string>NovelDL</string>
	<key>NXDisplayName</key>
	<string>NovelDL</string>
	<key>NXOrganizationPrefix</key>
	<string>app.noveldl</string>
	<key>NXBundleIdentifier</key>
	<string>app.noveldl.NovelDL</string>
	<!-- iPhone 12 mini (A14) は iOS 18〜26 を実行可能。Nyxian 公式対応下限 18.0。 -->
	<key>NXDeploymentTarget</key>
	<string>18.0</string>
	<key>NXSignMachOWithNyxianEntitlements</key>
	<true/>
	<key>NXClangFlags</key>
	<array>
		<!-- NXCodeTemplate の App 基本フラグ（そのまま） -->
		<string>-target</string>
		<string>arm64-apple-ios$(NXDeploymentTarget)</string>
		<string>-isysroot</string>
		<string>$(SDKROOT)</string>
		<string>-resource-dir</string>
		<string>$(BSROOT)/Include</string>
		<string>-L$(BSROOT)/lib</string>
		<string>-lclang_rt.ios</string>
		<string>-fobjc-arc</string>
		<string>-framework</string>
		<string>Foundation</string>
		<string>-framework</string>
		<string>UIKit</string>
		<!-- NovelDL 追加分: C++ コアと CoreText 縦組み描画・NSURLSession 用 -->
		<string>-I$(SRCROOT)/NovelCore/include</string>
		<string>-I$(SRCROOT)/NovelCore/src</string>
		<string>-framework</string>
		<string>SwiftUI</string>
		<string>-framework</string>
		<string>CoreGraphics</string>
		<string>-framework</string>
		<string>CoreText</string>
		<string>-lsqlite3</string>
		<string>-lc++</string>
	</array>
	<key>NXLinkerFlags</key>
	<array/>
	<key>NXSwiftFlags</key>
	<array>
		<!-- NXCodeTemplate の App 基本フラグ（そのまま） -->
		<string>-target</string>
		<string>arm64-apple-ios$(NXDeploymentTarget)</string>
		<string>-Xllvm</string>
		<string>-aarch64-use-tbi</string>
		<string>-Xfrontend</string>
		<string>-enable-objc-interop</string>
		<string>-sdk</string>
		<string>$(SDKROOT)</string>
		<string>-resource-dir</string>
		<string>$(BSROOT)/swift</string>
		<string>-module-cache-path</string>
		<string>$(BSROOT)/ModuleCache</string>
		<string>-parse-as-library</string>
		<!-- Swift ↔ C ABI ブリッジ（novel_core.h / nc_http_apple.h） -->
		<string>-import-objc-header</string>
		<string>$(SRCROOT)/Config/NovelDL-Bridging-Header.h</string>
	</array>
	<key>NXBundleVersion</key>
	<string>1.0</string>
	<key>NXBundleShortVersion</key>
	<string>1.0</string>
	<key>NXOutputPath</key>
	<string>$(CACHEROOT)/Payload/$(NXDisplayName).app/$(NXExecutable)</string>
	<key>NXBundleInfo</key>
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>ja</string>
		<key>CFBundleExecutable</key>
		<string>$(NXExecutable)</string>
		<key>CFBundleIdentifier</key>
		<string>$(NXBundleIdentifier)</string>
		<key>CFBundleName</key>
		<string>$(NXDisplayName)</string>
		<key>CFBundleDisplayName</key>
		<string>$(NXDisplayName)</string>
		<key>CFBundleVersion</key>
		<string>$(NXBundleVersion)</string>
		<key>CFBundleShortVersionString</key>
		<string>$(NXBundleShortVersion)</string>
		<key>MinimumOSVersion</key>
		<string>$(NXDeploymentTarget)</string>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
		<key>UIRequiresFullScreen</key>
		<false/>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UILaunchScreen</key>
		<dict/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>$(NXBundleIdentifier)</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>novelios</string>
				</array>
			</dict>
		</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>processing</string>
		</array>
	</dict>
</dict>
</plist>
